# AyurCTMS Environment Configuration Template
# Regulatory Compliant & OWASP Hardened Clinical Trial Platform
# INSTRUCTIONS: Copy this file to .env and replace placeholder values with actual secrets.

PROJECT_NAME=AyurCTMS
ENVIRONMENT=development
VERSION=2.4.0-Enterprise-Compliant

# Database Connection (PostgreSQL in production; SQLite supported for local development)
DATABASE_URL=sqlite:///./ayur_ctms.db
# DATABASE_URL=postgresql://ayur_app:YOUR_DB_PASSWORD@localhost:5432/ayurctms_prod

# Cryptography & Secrets (Rotate every 90 days per OWASP Top 10 guidelines)
SECRET_KEY=YOUR_MASTER_ENCRYPTION_KEY_32_BYTES_MIN
JWT_SECRET=YOUR_JWT_SIGNING_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# Indian Data Residency & Sovereign Clocks
PRIMARY_DATA_RESIDENCY=Mumbai, Maharashtra, India (ap-south-1)
NTP_PRIMARY=time.nic.in
NTP_SECONDARY=time.nplindia.org

# Regulatory Notification Channels
CERT_IN_OFFICIAL_EMAIL=incident@cert-in.org.in
CERT_IN_OFFICIAL_PHONE=1800-11-4949
DPO_EMAIL=dpo@ayurctms.gov.in

# ==============================
# SUPABASE CONFIGURATION
# ==============================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Safe for frontend/browser when RLS policies are correctly configured
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# BACKEND ONLY — NEVER expose to frontend
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY