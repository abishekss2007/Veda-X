# ==============================================================================
# Supabase Backend Configuration Template
# IMPORTANT SECURITY RULES:
# - SUPABASE_PUBLISHABLE_KEY (or SUPABASE_ANON_KEY): Safe for browser / frontend code
# - SUPABASE_SECRET_KEY (or SUPABASE_SERVICE_ROLE_KEY): BACKEND ONLY — NEVER expose to frontend!
# - NEVER commit your real .env file to Git
# ==============================================================================

# Supabase Project Base URL (do NOT include /rest/v1/ suffix)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Safe for frontend/browser when RLS policies are enabled
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# BACKEND ONLY — Bypass RLS for administrative tasks. NEVER expose to browser.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Demonstration mode flag (allows '123456' OTP code for testing)
DEMO_MODE=true
