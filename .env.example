# ==============================================================================
# AyurCTMS Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. SUPABASE_PUBLISHABLE_KEY: Safe for frontend / browser code (RLS enforced).
# 2. SUPABASE_SECRET_KEY: BACKEND ONLY. NEVER expose to frontend JavaScript.
# 3. NEVER prefix SUPABASE_SECRET_KEY with NEXT_PUBLIC_ or VITE_.
# 4. NEVER hardcode any Supabase key in source code.
# 5. NEVER commit your actual .env file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable Key (safe for browser/frontend with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Service Role Key (SERVER ONLY - never expose to browser or client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# FRONTEND / DEMO CONFIGURATION
# ------------------------------------------------------------------------------
# Demo Mode Toggle (true enables demo logins and simulated data, false for strict prod)
NEXT_PUBLIC_DEMO_MODE=true

# API Base URL (leave blank if proxied via same-origin /api/*)
NEXT_PUBLIC_API_BASE_URL=


# ------------------------------------------------------------------------------
# BACKEND CORE CONFIGURATION (FastAPI Server)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=AyurCTMS
VERSION=2.4.0-Enterprise-Compliant

# Local or Production Database
DATABASE_URL=sqlite:///./ayur_ctms.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ayurctms

# Cryptography & Security Secrets
SECRET_KEY=YOUR_32_CHAR_MIN_ENCRYPTION_MASTER_KEY!
JWT_SECRET=YOUR_JWT_SIGNING_SECURE_TOKEN_KEY!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# Demonstration Mode (Set to false in production)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Regulatory Notification & Sovereign Clock Endpoints
PRIMARY_DATA_RESIDENCY=Mumbai, Maharashtra, India (ap-south-1)
CERT_IN_OFFICIAL_EMAIL=incident@cert-in.org.in
CERT_IN_OFFICIAL_PHONE=1800-11-4949
DPO_EMAIL=dpo@ayurctms.gov.in
